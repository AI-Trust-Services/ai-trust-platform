    {
      "id": "TRANSPARENCY",
      "activate": true,
      "definition": "At least one configured transparency-related condition applies to the AI system. This label is evaluated independently of the base risk classification.",
      "rules": [
        {
          "id": "INTERACTION_WITH_NATURAL_PERSONS",
          "when": {
            "questionId": "Transparency_1",
            "operator": "IN",
            "values": [
              "YES",
              "PARTIALLY"
            ]
          }
        },
        {
          "id": "SYNTHETIC_CONTENT",
          "when": {
            "questionId": "Transparency_2",
            "operator": "IN",
            "values": [
              "YES",
              "PARTIALLY"
            ]
          }
        },
        {
          "id": "DEEPFAKE",
          "when": {
            "questionId": "Transparency_3",
            "operator": "IN",
            "values": [
              "YES",
              "PARTIALLY"
            ]
          }
        },
        {
          "id": "PUBLIC_INTEREST_TEXT_WITHOUT_FULL_EDITORIAL_EXCEPTION",
          "when": {
            "all": [
              {
                "questionId": "Transparency_4",
                "operator": "IN",
                "values": [
                  "YES",
                  "PARTIALLY"
                ]
              },
              {
                "questionId": "Transparency_5",
                "operator": "IN",
                "values": [
                  "NO",
                  "PARTIALLY"
                ]
              }
            ]
          }
        },
        {
          "id": "EMOTION_RECOGNITION_OR_BIOMETRIC_CATEGORISATION",
          "when": {
            "questionId": "Transparency_6",
            "operator": "IN",
            "values": [
              "YES",
              "PARTIALLY"
            ]
          }
        },
        {
          "id": "HIGH_RISK_DECISION_OR_DECISION_SUPPORT",
          "when": {
            "questionId": "Transparency_7",
            "operator": "IN",
            "values": [
              "YES",
              "PARTIALLY"
            ]
          }
        }
      ]
    }
