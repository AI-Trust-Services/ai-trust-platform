  "roleLabels": [
    {
      "id": "PROVIDER",
      "activate": true,
      "definition": "A natural or legal person that develops an AI system or GPAI model, has it developed and places it on the market or puts it into service under its own name or trademark, or otherwise assumes provider obligations through the configured provider-triggering situations.",
      "rules": [
        {
          "id": "PROVIDER_ROLE",
          "when": {
            "any": [
              {
                "questionId": "Role_4",
                "operator": "EQUALS",
                "value": "YES"
              },
              {
                "questionId": "Role_5",
                "operator": "EQUALS",
                "value": "YES"
              },
              {
                "questionId": "Role_6",
                "operator": "EQUALS",
                "value": "YES"
              },
              {
                "questionId": "Role_7",
                "operator": "EQUALS",
                "value": "YES"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "DEPLOYER",
      "activate": true,
      "definition": "A natural or legal person who uses the AI system under its own responsibility.",
      "rules": [
        {
          "id": "DEPLOYER_ROLE",
          "when": {
            "questionId": "Role_3",
            "operator": "EQUALS",
            "value": "YES"
          }
        }
      ]
    },
    {
      "id": "IMPORTER",
      "activate": true,
      "definition": "A natural or legal person established in the Union that places on the market an AI system bearing the name or trademark of a natural or legal person established outside the Union.",
      "rules": [
        {
          "id": "IMPORTER_ROLE",
          "when": {
            "questionId": "Role_2",
            "operator": "EQUALS",
            "value": "YES"
          }
        }
      ]
    },
    {
      "id": "DISTRIBUTOR",
      "activate": false,
      "definition": "A natural or legal person in the supply chain, other than the provider or importer, that makes an AI system available on the Union market.",
      "rules": []
    },
    {
      "id": "AUTHORISED_REPRESENTATIVE",
      "activate": true,
      "definition": "A natural or legal person established in the Union that has received and accepted a written mandate from a provider to perform specified obligations on the provider's behalf.",
      "rules": [
        {
          "id": "AUTHORISED_REPRESENTATIVE_ROLE",
          "when": {
            "questionId": "Role_1",
            "operator": "EQUALS",
            "value": "YES"
          }
        }
      ]
    }
  ]
