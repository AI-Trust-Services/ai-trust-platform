// ─────────────────────────────────────────────────────────────────────────────
// rbac-platform-patch.js — GENERATED by prepare-app.sh --sso-mode jwt-trust
//
// Drop-in replacement for your app's requireAuth middleware that trusts the
// AI Trust Platform identity instead of running your app's own OIDC/login.
//
// HOW TO APPLY
// ─────────────
// 1. Copy the `platformIdentity` and `requireAuth` functions below into your
//    app's auth/rbac module (e.g. rbac.js, auth.js, middleware/auth.js).
// 2. Replace your existing `requireAuth` (or equivalent) with the one below.
// 3. Set PLATFORM_SSO=off in your .env to keep using your own login locally.
// 4. Build with Dockerfile.nosso and register in the Marketplace with:
//      Platform SSO: OFF
//      App port    : @@UPSTREAM_PORT@@
//
// HOW IT WORKS
// ─────────────
// The AI Trust Platform (oauth2-proxy + marketplace proxy) already verified the
// user before the request reaches your app. The user's identity arrives as:
//   • X-Forwarded-Preferred-Username header  (if oauth2-proxy passes user headers)
//   • Authorization: Bearer <JWT>            (always present on MT deployments)
//
// We read whichever is available. The JWT is decoded WITHOUT re-verifying the
// signature because the platform already did that. This is safe only because
// the app pod is reachable exclusively through the platform proxy — see the
// security note below.
//
// SECURITY NOTE
// ─────────────
// If your pod is directly reachable (no NetworkPolicy), a crafted JWT header
// could bypass auth. Apply a NetworkPolicy restricting ingress to the
// marketplace proxy. Optionally verify the JWT against the platform JWKS.
// ─────────────────────────────────────────────────────────────────────────────

"use strict";

// Decode preferred_username from a platform-verified Bearer JWT (no signature check).
function _decodeJwtUsername(authHeader) {
  try {
    const m = /^Bearer\s+(.+)$/i.exec(String(authHeader || "").trim());
    if (!m) return "";
    const parts = m[1].split(".");
    if (parts.length < 2) return "";
    const payload = Buffer.from(
      parts[1].replace(/-/g, "+").replace(/_/g, "/"),
      "base64"
    ).toString("utf8");
    const claims = JSON.parse(payload);
    return (
      claims.preferred_username ||
      claims.email ||
      claims.sub ||
      ""
    ).toString().trim();
  } catch {
    return "";
  }
}

// Extract the platform identity from the request headers.
// Tries X-Forwarded-Preferred-Username first (set by oauth2-proxy --pass-user-headers),
// then falls back to decoding the Bearer JWT (set on all MT deployments).
function platformIdentity(req) {
  const header = (
    req.headers["x-forwarded-preferred-username"] ||
    req.headers["x-forwarded-user"] ||
    ""
  ).toString().trim();
  return header || _decodeJwtUsername(req.headers["authorization"]);
}

// Drop-in requireAuth middleware.
//
// When PLATFORM_SSO=on (default) — trusts the platform identity; skips the
// app's own login. Any user who can reach the app is already platform-authorized.
// When PLATFORM_SSO=off — falls through to the app's own login (local dev).
//
// Adapt the session shape and role assignment to match your app.
// The example below grants every platform user all roles — change as needed.
function requireAuth(req, res, next) {
  // Already have a session (own login or prior platform auth).
  if (req.session && req.session.user) return next();

  // Platform identity path — active unless explicitly disabled.
  if ((process.env.PLATFORM_SSO || "on").toLowerCase() !== "off") {
    const username = platformIdentity(req);
    if (username) {
      // Establish a session under the platform identity.
      // ADAPT: assign roles appropriate to your app's RBAC model.
      req.session.user = {
        username,
        roles: ["admin"], // grant full access; refine if you have role logic
      };
      return next();
    }
  }

  // Fall back to the app's own login.
  if (req.path.startsWith("/api/")) {
    return res.status(401).json({ error: "unauthenticated" });
  }
  return res.redirect("/login");
}

// Export for use in your app.
module.exports = { platformIdentity, requireAuth };
