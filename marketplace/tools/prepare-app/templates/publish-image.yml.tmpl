# GENERATED by marketplace/tools/prepare-app — publish the app image to ghcr.io.
#
# Builds the platform-ready Dockerfile and pushes it to
# ghcr.io/<owner>/<repo>:@@IMAGE_TAG@@ on every push to @@BRANCH@@.
# The Marketplace registers that ref.
#
# Dockerfile built:
#   sidecar mode (Path A) → Dockerfile.platform-sso   tag :sso
#   jwt-trust mode (Path B) → Dockerfile.nosso         tag :nosso
#
# ── ONE-TIME REPO SETTING (required) ───────────────────────────────────────────
# If a run fails with `denied: permission_denied: write_package`, set
#   Settings → Actions → General → Workflow permissions → Read and write permissions.
# The `permissions:` block below cannot elevate above a read-only repo default.
# ───────────────────────────────────────────────────────────────────────────────
name: publish-image

on:
  push:
    branches: [@@BRANCH@@]
  workflow_dispatch:

permissions:
  contents: read
  packages: write

jobs:
  build-and-push:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - uses: docker/setup-buildx-action@v3
        with:
          platforms: linux/amd64
      - uses: docker/build-push-action@v6
        with:
          context: .
          file: Dockerfile.@@IMAGE_TAG@@
          platforms: linux/amd64
          push: true
          tags: |
            ghcr.io/${{ github.repository }}:@@IMAGE_TAG@@
            ghcr.io/${{ github.repository }}:${{ github.sha }}
