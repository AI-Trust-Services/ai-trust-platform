# ============================================================================
#  AI Trust Platform — deployment configuration  (copy to config.env, then edit)
# ============================================================================
#  cp prerequisites/config.env.example prerequisites/config.env
#  then fill every <PLACEHOLDER> below and run ./scripts/deploy.sh
#
#  This bundle deploys the AI Trust Platform STANDALONE (its own Keycloak +
#  oauth2-proxy, own Postgres/ClickHouse/MinIO/RabbitMQ) onto ANY Kubernetes
#  cluster. It is cluster-agnostic and does NOT assume a Platform Mesh — see
#  INGRESS_MODE below for how it gets exposed.
# ----------------------------------------------------------------------------

# ── Public URL ──────────────────────────────────────────────────────────────
# The externally-reachable HTTPS URL of the app. Everything (Keycloak issuer,
# oauth2-proxy redirect, CORS origin) is derived from this. No trailing slash.
APP_DOMAIN="<your.app.hostname>"                 # e.g. ai-trust.example.com
APP_URL="https://<your.app.hostname>"            # e.g. https://ai-trust.example.com

# ── Tenancy ──────────────────────────────────────────────────────────────────
# single = one organisation, no per-tenant isolation (the default; what this
#          standalone bundle installs).
# jwt    = multi-tenant. NOT provisioned by this bundle on its own (needs the
#          MSP operator to stamp per-tenant realms/schemas). Leave as single here.
TENANCY_MODE="single"

# ── Container image registry ──────────────────────────────────────────────────
# Where the built app images live. REQUIRED unless INGRESS_MODE=kind (see below),
# in which case images are loaded straight into the kind node and REGISTRY is
# ignored. For any real cluster: set this to a registry you can push to and run
# `docker login` first. Images are pushed as  $REGISTRY/aitrust-<component>:$TAG.
REGISTRY="<your-registry>"                       # e.g. docker.io/youruser  or  ghcr.io/org
TAG="v1"                                         # image tag; day-2 update.sh appends the git sha

# ── App source (built from git) ───────────────────────────────────────────────
# The scripts always build from this git repo (never a stale local checkout).
APP_GIT_URL="https://github.com/AI-Trust-Services/ai-trust-platform.git"
APP_GIT_REF="main"                               # branch, tag, or commit to build

# ── Target namespace ──────────────────────────────────────────────────────────
APP_NS="ai-trust-app"

# ── Cluster context (optional) ────────────────────────────────────────────────
# Leave blank to use your kubectl current-context. Set to target a specific
# context without changing your global kubectl state. Honoured by both the bash
# and PowerShell scripts.
KUBE_CONTEXT=""

# ── Ingress mode ──────────────────────────────────────────────────────────────
# How the app gets exposed. Pick ONE:
#   ingress  — create a standard Kubernetes Ingress (needs an ingress controller,
#              e.g. nginx/traefik, in the cluster). Portable default for real clusters.
#   gateway  — attach to an existing Gateway-API Gateway (advanced; set GATEWAY_* below).
#   kind     — local kind cluster: NodePort + no registry (images are `kind load`ed).
#              Great for a laptop trial; not for production.
#   none     — deploy the workloads only; you wire your own ingress afterwards.
INGRESS_MODE="ingress"

# TLS for INGRESS_MODE=ingress:
#   provided        — you supply prerequisites/tls.crt + tls.key (see prerequisites/README.md)
#   cert-manager    — annotate the Ingress for cert-manager (set CERT_ISSUER)
#   none            — HTTP only / TLS handled upstream (a cloud LB, service mesh, etc.)
TLS_MODE="provided"
CERT_ISSUER=""                                   # cert-manager ClusterIssuer name (if TLS_MODE=cert-manager)
INGRESS_CLASS=""                                 # e.g. nginx  (blank = cluster default)

# Gateway-API settings (only when INGRESS_MODE=gateway) ------------------------
GATEWAY_NS=""                                     # namespace of the Gateway
GATEWAY_NAME=""                                   # name of the Gateway
GATEWAY_LISTENER="terminate-aitrust"              # a dedicated listener this bundle adds
GATEWAY_TLS_SECRET=""                             # existing TLS secret the listener terminates with
GATEWAY_PORT="8443"                               # listener port

# ── Node placement (optional) ─────────────────────────────────────────────────
# Pin the app to specific nodes. Leave blank to schedule anywhere.
# If set, nodes must carry the label AND (optionally) the matching taint is tolerated.
NODE_LABEL_KEY=""                                 # e.g. workload
NODE_LABEL_VALUE=""                               # e.g. ai-trust-app
NODE_TAINT="false"                                # true = also tolerate a NoSchedule taint <key>=<value>

# ── Storage ────────────────────────────────────────────────────────────────────
# Leave blank to use the cluster's default StorageClass. Set to pin a class.
STORAGE_CLASS=""

# ── Image pull policy ──────────────────────────────────────────────────────────
# IfNotPresent is efficient but does NOT re-pull a moved tag — use unique tags
# (update.sh does) or set Always if you re-push the same tag.
IMAGE_PULL_POLICY="IfNotPresent"
