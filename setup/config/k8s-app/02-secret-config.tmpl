apiVersion: v1
kind: Secret
metadata: { name: app-secrets, namespace: __APP_NS__ }
stringData:
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: "__POSTGRES_PASSWORD__"
  RABBITMQ_USER: guest
  RABBITMQ_PASSWORD: guest
  CLICKHOUSE_USER: default
  CLICKHOUSE_PASSWORD: ""
  MINIO_ROOT_USER: minioadmin
  MINIO_ROOT_PASSWORD: "__MINIO_ROOT_PASSWORD__"
  KEYCLOAK_ADMIN: admin
  KEYCLOAK_ADMIN_PASSWORD: "__KEYCLOAK_ADMIN_PASSWORD__"
  # Shared OIDC client secret for oauth2-proxy (and the users-backend service account).
  KEYCLOAK_CLIENT_SECRET: "__KEYCLOAK_CLIENT_SECRET__"
  USERS_BACKEND_CLIENT_SECRET: "__USERS_BACKEND_CLIENT_SECRET__"
  APP_ADMIN_USERNAME: admin
  APP_ADMIN_PASSWORD: "__APP_ADMIN_PASSWORD__"
  # Exactly 16, 24, or 32 chars — generated fresh by the deploy script.
  OAUTH2_PROXY_COOKIE_SECRET: "__COOKIE_SECRET__"
  DATABASE_URL: postgresql+asyncpg://postgres:__POSTGRES_PASSWORD__@postgres:5432/ai_trust
  RABBITMQ_URL: amqp://guest:guest@rabbitmq:5672/
---
apiVersion: v1
kind: ConfigMap
metadata: { name: app-config, namespace: __APP_NS__ }
data:
  TENANCY_MODE: "__TENANCY_MODE__"
  CLICKHOUSE_HOST: clickhouse
  CLICKHOUSE_PORT: "8123"
  ALLOWED_ORIGINS: "__APP_URL__"
  APP_PUBLIC_URL: "__APP_URL__"
  KEYCLOAK_PUBLIC_URL: "__APP_URL__/keycloak"
  MINIO_ENDPOINT: "minio:9000"
  MINIO_PUBLIC_ENDPOINT: "localhost:9000"
  MINIO_SECURE: "false"
  MINIO_REGION: "us-east-1"
  # AI-assisted registration: stub (offline default) | ollama | external.
  # For `external`, add AI_CLIENT_ID / AI_CLIENT_SECRET / AI_AUTH_URL / AI_API_URL /
  # AI_DEPLOYMENT_ID to the Secret above and set LLM_PROVIDER=external here.
  LLM_PROVIDER: "stub"
  # SMTP is OPTIONAL — leave SMTP_HOST empty to disable outgoing email.
  SMTP_HOST: ""
