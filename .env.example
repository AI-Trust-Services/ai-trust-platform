# Copy this file to .env and fill in real values before running docker compose.
# Never commit .env to git.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Retry config for otel-rmq-bridge startup (optional — these are the defaults)
# RMQ_CONNECT_RETRIES=10
# RMQ_CONNECT_DELAY=3.0

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Frontend build — backend API base URL baked into the bundle by Vite at build time
VITE_API_BASE=http://localhost:8001/api/v1
