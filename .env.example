# Copy this file to .env and fill in real values before running docker compose.
# Never commit .env to git.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Retry config for otel-rmq-bridge startup (optional — these are the defaults)
# RMQ_CONNECT_RETRIES=10
# RMQ_CONNECT_DELAY=3.0

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# MinIO (Cold storage for ClickHouse tiering)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Frontend build — backend API base URLs baked into bundles by Vite at build time
VITE_ALERTS_API_BASE=/api/alerts/v1
VITE_ALERTS_URL=http://localhost:8080/alerts
VITE_COMPLIANCE_API_BASE=/api/compliance/v1
VITE_COMPLIANCE_URL=http://localhost:8080/compliance
VITE_DTA_API_BASE=/api/dta/v1
VITE_MONITORING_API_BASE=/api/monitoring/v1
VITE_OVERVIEW_API_BASE=/api/overview/v1
VITE_REGISTRY_API_BASE=/api/registry/v1
VITE_REGISTRY_URL=http://localhost:8080/registry
VITE_USERS_API_BASE=/api/users/v1

# Compliance backend — MinIO evidence storage
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_REGION=us-east-1

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Shared secret between Keycloak and oauth2-proxy. Rotate before any non-local deployment.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
KEYCLOAK_CLIENT_SECRET=change-me-oauth2-proxy-secret
# Secret for the users-backend service account client. Rotate before any non-local deployment.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
USERS_BACKEND_CLIENT_SECRET=change-me-users-backend-secret
# ─────────────────────────────────────────────────────────────────────────────
# TENANCY MODE — single-tenant vs multi-tenant. Choose ONE.
#   single (default) — ONE organization on this deployment. One Keycloak realm,
#                       one shared Postgres schema, no per-tenant isolation. This
#                       is the right choice for docker-compose, the local kind
#                       install, and any standalone single-org deployment.
#   jwt              — MULTI-TENANT. The tenant is resolved from a `tenant_id`
#                       claim in the OIDC token; data is isolated per tenant
#                       (schema-per-tenant Postgres + role, per-tenant Keycloak
#                       realm, per-tenant ClickHouse DB / MinIO bucket). Requires
#                       TENANCY_JWKS_ISSUER_BASE and is normally deployed via the
#                       MSP operator bundle, not this .env. Do NOT set jwt for a
#                       plain single-org install.
# The k8s installer (cd k8s && make up) will PROMPT for this and write it here.
TENANCY_MODE=single
# Only for TENANCY_MODE=jwt — trusted issuer prefix, e.g.
#   https://<host>/keycloak/realms/   (the tenant realm is appended per request)
TENANCY_JWKS_ISSUER_BASE=
TENANT_CLAIM=tenant_id

# Public URL of Keycloak reachable by the browser.
# Local: http://localhost:8180   Production: https://auth.yourdomain.com
KEYCLOAK_PUBLIC_URL=http://localhost:8180
# Public URL of the app (oauth2-proxy) reachable by the browser.
# Local: http://localhost:8080   Production: https://app.yourdomain.com
APP_PUBLIC_URL=http://localhost:8080
# Bootstrap platform admin user (created in Keycloak on first startup)
# Change before any non-local deployment.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=password

# oauth2-proxy cookie encryption secret — must be exactly 16, 24, or 32 characters
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
OAUTH2_PROXY_COOKIE_SECRET=change-me-32-char-secret-here!!!

# CORS — required by all backends (fail-fast if unset). Comma-separated origins.
# Local: http://localhost:8080   Production: https://your-app-domain.com
ALLOWED_ORIGINS=http://localhost:8080

# AI System Registry — email notifications (SMTP)
# Local dev default: Mailpit (no auth, no TLS) on port 1025 — web UI at http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ai-trust.local
SMTP_SSL=false
SMTP_STARTTLS=false
SMTP_FROM_NAME="AI Trust Platform"
USERS_BACKEND_URL=http://users-backend:8008

# AI System Registry — AI-assisted registration LLM
# LLM_PROVIDER: stub (default, offline/deterministic — no network), ollama, or external.
# Leave as stub for local dev/CI; the assisted flow works end-to-end without any LLM.
# NOTE: the stub ignores user input and walks a fixed demo script — for a real
# conversation that responds to answers, use ollama or external.
#
# To use ollama: set LLM_PROVIDER=ollama below and start the bundled ollama
# container via the compose profile (it is off by default):
#   docker compose --profile ollama up -d
# The models below are swappable — the ollama-pull job downloads exactly these,
# and the backend uses them. Change them here and re-run the command above.
LLM_PROVIDER=stub
# ollama / OpenAI-compatible endpoint (used when LLM_PROVIDER=ollama)
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
LLM_VISION_MODEL=llama3.2-vision
# External provider — OAuth2 client-credentials + Anthropic-format /invoke (required only when LLM_PROVIDER=external)
AI_CLIENT_ID=
AI_CLIENT_SECRET=
AI_AUTH_URL=
AI_API_URL=
AI_RESOURCE_GROUP=default
AI_DEPLOYMENT_ID=
AI_API_VERSION=bedrock-2023-05-31
# Conversation / document tuning (optional — defaults shown)
ASSIST_TURN_CAP=12
ASSIST_MAX_TEXT_LENGTH=15000
