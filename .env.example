# Copy this file to .env and fill in real values before running docker compose.
# Never commit .env to git.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Retry config for otel-rmq-bridge startup (optional — these are the defaults)
# RMQ_CONNECT_RETRIES=10
# RMQ_CONNECT_DELAY=3.0

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# MinIO (Cold storage for ClickHouse tiering)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Frontend build — backend API base URLs baked into bundles by Vite at build time
VITE_ALERTS_API_BASE=/api/alerts/v1
VITE_ALERTS_URL=http://localhost:8080/alerts
VITE_COMPLIANCE_API_BASE=/api/compliance/v1
VITE_COMPLIANCE_URL=http://localhost:8080/compliance
VITE_DTA_API_BASE=/api/dta/v1
VITE_MONITORING_API_BASE=/api/monitoring/v1
VITE_OVERVIEW_API_BASE=/api/overview/v1
VITE_REGISTRY_API_BASE=/api/registry/v1
VITE_REGISTRY_URL=http://localhost:8080/registry
VITE_USERS_API_BASE=/api/users/v1

# Compliance backend — MinIO evidence storage
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_REGION=us-east-1

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Shared secret between Keycloak and oauth2-proxy. Rotate before any non-local deployment.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
KEYCLOAK_CLIENT_SECRET=change-me-oauth2-proxy-secret
# Secret for the users-backend service account client. Rotate before any non-local deployment.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
USERS_BACKEND_CLIENT_SECRET=change-me-users-backend-secret
# Public URL of Keycloak reachable by the browser.
# Local: http://localhost:8180   Production: https://auth.yourdomain.com
KEYCLOAK_PUBLIC_URL=http://localhost:8180
# Public URL of the app (oauth2-proxy) reachable by the browser.
# Local: http://localhost:8080   Production: https://app.yourdomain.com
APP_PUBLIC_URL=http://localhost:8080
# Set to "true" to provision dev users (admin/engineer/compliance/auditor) on startup.
# Keep "false" in production — provision real users via the Keycloak admin console.
PROVISION_DEV_USERS=true

# oauth2-proxy cookie encryption secret — must be exactly 16, 24, or 32 characters
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
OAUTH2_PROXY_COOKIE_SECRET=change-me-32-char-secret-here!!!

# Authorization (OpenFGA)
# Username granted the Platform Administrator role on startup by openfga-provision.
# In local dev, PROVISION_DEV_USERS=true already seeds the "admin" user as Platform
# Admin, so this can be left blank. In production, set it to a real Keycloak username
# to bootstrap the first admin (who can then assign roles via the Role Management UI).
INITIAL_ADMIN_USER=
