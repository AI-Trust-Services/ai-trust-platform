# Copy this file to .env and fill in real values before running docker compose.
# Never commit .env to git.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Retry config for otel-rmq-bridge startup (optional — these are the defaults)
# RMQ_CONNECT_RETRIES=10
# RMQ_CONNECT_DELAY=3.0

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# MinIO (Cold storage for ClickHouse tiering)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Frontend build — backend API base URLs baked into bundles by Vite at build time
VITE_REGISTRY_API_BASE=http://localhost:8001/api/v1
VITE_OVERVIEW_API_BASE=http://localhost:8004/api/v1
VITE_MONITORING_API_BASE=http://localhost:8003/api/v1
VITE_ALERTS_API_BASE=http://localhost:8005/api/v1
VITE_ALERTS_URL=http://localhost:3004
VITE_REGISTRY_URL=http://localhost:3001
# Decision Trace Analyzer serves its API behind an nginx/Vite proxy, so a
# relative path is the default (iframe-safe inside the Luigi shell). Override
# with an absolute URL only when deployed behind a path prefix or a proxy that
# does not preserve /api/.
VITE_DTA_API_BASE=/api/v1
VITE_COMPLIANCE_API_BASE=http://localhost:8007/api/v1

# Compliance backend — MinIO evidence storage
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_REGION=us-east-1

# some changes
CHANGE=
