# Copy this file to .env and fill in real values before running make up.
# Never commit .env to git.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Retry config for otel-rmq-bridge startup (optional — these are the defaults)
# RMQ_CONNECT_RETRIES=10
# RMQ_CONNECT_DELAY=3.0

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# MinIO (Cold storage for ClickHouse tiering)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Frontend build — backend API base URLs baked into bundles by Vite at build time
VITE_ALERTS_API_BASE=/api/alerts/v1
VITE_ALERTS_URL=http://localhost:8080/alerts
VITE_COMPLIANCE_API_BASE=/api/compliance/v1
VITE_COMPLIANCE_URL=http://localhost:8080/compliance
VITE_DTA_API_BASE=/api/dta/v1
VITE_MONITORING_API_BASE=/api/monitoring/v1
VITE_OVERVIEW_API_BASE=/api/overview/v1
VITE_REGISTRY_API_BASE=/api/registry/v1
VITE_REGISTRY_URL=http://localhost:8080/registry
VITE_USERS_API_BASE=/api/users/v1
VITE_AUDIT_API_BASE=/api/audit/v1
VITE_ADMIN_API_BASE=/api/admin/v1
VITE_INDEXING_API_BASE=/api/indexing/v1
VITE_TESTBED_API_BASE=/api/ai-test-bed/v1

# Compliance backend — MinIO evidence storage
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_REGION=us-east-1

# Document indexing (document-indexing-backend/-worker + embedding-service)
# Multilingual dense embeddings, served once by embedding-service and shared by
# index- and query-time. Supported: intfloat/multilingual-e5-small (384-dim, default,
# fast on CPU), intfloat/multilingual-e5-base (768-dim).
# Switching the model requires a matching EMBEDDING_DIM migration + re-index.
# E5 prefixes (query:/passage:) are applied server-side by kind.
EMBED_MODEL=intfloat/multilingual-e5-small
# MinIO bucket for original uploaded documents (single-tenant mode).
INDEXING_BUCKET=indexing-docs
# Worker poll cadence (seconds) for pending documents.
INDEXING_POLL_INTERVAL=10
# URL of the registry backend, used by the AI Test Bed orchestrator to call /classify/evaluate.
REGISTRY_BACKEND_URL=http://ai-system-registry-backend:8001
# URL of the document-indexing backend, used by the AI Test Bed orchestrator and seed for retrieval and doc upload.
INDEXING_BACKEND_URL=http://document-indexing-backend:8011

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Shared secret between Keycloak and oauth2-proxy. Rotate before any non-local deployment.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
KEYCLOAK_CLIENT_SECRET=change-me-oauth2-proxy-secret
# Secret for the users-backend service account client. Rotate before any non-local deployment.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
USERS_BACKEND_CLIENT_SECRET=change-me-users-backend-secret
# ─────────────────────────────────────────────────────────────────────────────
# TENANCY MODE — single-tenant vs multi-tenant. Choose ONE.
#   single (default) — ONE organization on this deployment. One Keycloak realm,
#                       one shared Postgres schema, no per-tenant isolation. This
#                       is the right choice for the local kind install and any
#                       standalone single-org deployment.
#   jwt              — MULTI-TENANT. The tenant is resolved from a `tenant_id`
#                       claim in the OIDC token; data is isolated per tenant
#                       (schema-per-tenant Postgres + role, per-tenant Keycloak
#                       realm, per-tenant ClickHouse DB / MinIO bucket). Requires
#                       TENANCY_JWKS_ISSUER_BASE and is normally deployed via the
#                       MSP operator bundle, not this .env. Do NOT set jwt for a
#                       plain single-org install.
# The k8s installer (make up from repo root) will PROMPT for this and write it here.
TENANCY_MODE=single
# Only for TENANCY_MODE=jwt — trusted issuer prefix, e.g.
#   https://<host>/keycloak/realms/   (the tenant realm is appended per request)
TENANCY_JWKS_ISSUER_BASE=
TENANT_CLAIM=tenant_id

# Public URL of Keycloak reachable by the browser.
# Local: http://localhost:8180   Production: https://auth.yourdomain.com
KEYCLOAK_PUBLIC_URL=http://localhost:8180
# Public URL of the app (oauth2-proxy) reachable by the browser.
# Local: http://localhost:8080   Production: https://app.yourdomain.com
APP_PUBLIC_URL=http://localhost:8080
# Bootstrap platform admin user (created in Keycloak on first startup)
# Change before any non-local deployment.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=password

# Dev users — one per built-in role (password: "password"). Remove before any non-local deployment.
SEED_DEV_USERS=true
DEV_USER_PASSWORD=password

# oauth2-proxy cookie encryption secret — must be exactly 16, 24, or 32 characters
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
OAUTH2_PROXY_COOKIE_SECRET=change-me-32-char-secret-here!!!

# CORS — required by all backends (fail-fast if unset). Comma-separated origins.
# Local: http://localhost:8080   Production: https://your-app-domain.com
ALLOWED_ORIGINS=http://localhost:8080

# AI System Registry — email notifications (SMTP)
# Local dev default: Mailpit (no auth, no TLS) on port 1025 — web UI at http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ai-trust.local
SMTP_SSL=false
SMTP_STARTTLS=false
SMTP_FROM_NAME="AI Trust Platform"
USERS_BACKEND_URL=http://users-backend:8008

# AI System Registry — AI-assisted registration (Thalamus inference backend)
# Thalamus is an OpenAI-compatible inference gateway. Set THALAMUS_BASE_URL to a
# running gateway (include the /v1 path); leave it unset or set it to "stub" for
# offline/deterministic stub mode (dev/CI — the assisted flow works end-to-end
# with no network; the stub walks a fixed demo script).
#
# Model switching is configuration-only: change THALAMUS_MODEL and redeploy — no
# code change. Use GET <THALAMUS_BASE_URL>/models to list available model IDs.
# THALAMUS_VISION_MODEL defaults to THALAMUS_MODEL if unset.
#
# THALAMUS_BEARER_TOKEN is sent as `Authorization: Bearer <token>`. It is REQUIRED
# whenever THALAMUS_BASE_URL is a real gateway (the backend fails fast at startup
# if it is empty); not needed in stub mode.
THALAMUS_BASE_URL=stub
THALAMUS_BEARER_TOKEN=
THALAMUS_MODEL=Qwen/Qwen3.8-27B
THALAMUS_VISION_MODEL=Qwen/Qwen3.8-27B
# Conversation / document tuning (optional — defaults shown)
ASSIST_TURN_CAP=12
ASSIST_MAX_TEXT_LENGTH=15000
# Batch import (off by default; enable in dev/test only)
ENABLE_BATCH_IMPORT=false

# Langfuse tracing (optional — leave blank to disable; backends start normally)
# A trace's project is fixed by the API key pair; per-deployment separation is
# done via the Langfuse "environment". LANGFUSE_TRACING_ENVIRONMENT is set
# automatically by k8s/scripts/bootstrap.sh / CI to the deploy namespace (= the
# GitHub username of whoever deployed) — do not set it by hand here.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Background workers
ALERT_POLL_INTERVAL=10        # seconds; 10s dev, 60s+ prod
AUDIT_FLUSH_INTERVAL=5        # seconds; 5s dev, 30-60s prod
AUDIT_FLUSH_BATCH_SIZE=500    # rows per flush cycle

# ---------------------------------------------------------------------------
# Cognee Eval
# ---------------------------------------------------------------------------
# LLM + embeddings run through Thalamus (THALAMUS_BASE_URL/MODEL/BEARER_TOKEN above).
# All provider/model config is set in code (cognee_client.py setup_cognee()).

# Direct cognee storage to the PVC mount (default is inside the package dir).
DATA_ROOT_DIRECTORY=/app/.cognee_system/data
SYSTEM_ROOT_DIRECTORY=/app/.cognee_system/system
GRAPH_DATABASE_PROVIDER=kuzu

# Cap cognee's LLM calls per minute to stay within the gateway's sustained token quota.
COGNEE_LLM_RATE_LIMIT_REQUESTS=60

# Read-only production mode. Keep false here (the shared default for every
# environment). The prod read-only deployment does NOT rely on this value — the
# Helm chart sets COGNEE_READONLY=true as an explicit container env in the prod
# branch (cogneeEval.readOnly=true), which overrides this Secret value. When
# true the ingest/feedback routers are unmounted (404) and the backend serves a
# frozen graph snapshot read-only. See cognee-eval/CLAUDE.md.
COGNEE_READONLY=false

# ---------------------------------------------------------------------------
# GHCR (private image pulls) — local kind only
# ---------------------------------------------------------------------------
# PAT with read:packages. Only needed to pull PRIVATE GHCR images on kind (e.g.
# the cognee-eval read-only graph snapshot). Leave blank if you don't pull
# private images. When set, bootstrap.sh creates the `ghcr-pull-secret` secret
# (same name Gardener uses). Gardener gets this from the CI GHCR_PULL_TOKEN, not
# from this file.
GHCR_PULL_TOKEN=
