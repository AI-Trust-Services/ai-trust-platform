# Gardener shoot: sr-test (project: ai-trust)
# Traefik LoadBalancer IP: 130.214.18.165
# DNS via nip.io (free wildcard DNS resolving to the LB IP, no setup needed).
#
# Copy this file to .env when deploying to the Gardener sr-test shoot cluster.
# For local kind/docker-compose, use .env.example instead.
# Never commit .env to git.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# MinIO (Cold storage for ClickHouse tiering)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Frontend build — backend API base URLs baked into bundles by Vite at build time.
# All relative paths — traffic enters via the app public URL and is proxied by the shell nginx.
VITE_ALERTS_API_BASE=/api/alerts/v1
VITE_ALERTS_URL=http://ai-trust.130.214.18.165.nip.io/alerts
VITE_COMPLIANCE_API_BASE=/api/compliance/v1
VITE_COMPLIANCE_URL=http://ai-trust.130.214.18.165.nip.io/compliance
VITE_DTA_API_BASE=/api/dta/v1
VITE_MONITORING_API_BASE=/api/monitoring/v1
VITE_OVERVIEW_API_BASE=/api/overview/v1
VITE_REGISTRY_API_BASE=/api/registry/v1
VITE_REGISTRY_URL=http://ai-trust.130.214.18.165.nip.io/registry
VITE_USERS_API_BASE=/api/users/v1

# Compliance backend — MinIO evidence storage.
# MINIO_ENDPOINT: in-cluster address (unchanged from local).
# MINIO_PUBLIC_ENDPOINT: public host used by compliance-backend to presign
# download URLs the browser can reach. MinIO is exposed via its own Ingress entry.
# MINIO_PUBLIC_URL: full https URL — used by deploy-gardener.yml to create the MinIO Ingress.
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=minio.130.214.18.165.nip.io
MINIO_PUBLIC_URL=http://minio.130.214.18.165.nip.io
MINIO_SECURE=false
MINIO_REGION=us-east-1

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
KEYCLOAK_CLIENT_SECRET=change-me-oauth2-proxy-secret
USERS_BACKEND_CLIENT_SECRET=change-me-users-backend-secret
# Public URLs — must be reachable by the browser
KEYCLOAK_PUBLIC_URL=http://keycloak.130.214.18.165.nip.io
APP_PUBLIC_URL=http://ai-trust.130.214.18.165.nip.io

# Bootstrap platform admin user
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=password

# oauth2-proxy cookie encryption secret — must be exactly 16, 24, or 32 characters
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
OAUTH2_PROXY_COOKIE_SECRET=change-me-32-char-secret-here!!!

# CORS — backends fail to start if unset. Set to the app's public URL.
ALLOWED_ORIGINS=http://ai-trust.130.214.18.165.nip.io
