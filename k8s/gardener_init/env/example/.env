# Cluster init config template — copy to <cluster-name>.env and fill in.
# Used by shoot-cluster-init.sh — hostnames only, no credentials.
APP_HOST=<cluster-name>.<project>.shoot.gardener.<landscape>.apeirora.eu
KEYCLOAK_HOST=keycloak.<cluster-name>.<project>.shoot.gardener.<landscape>.apeirora.eu
MINIO_HOST=minio.<cluster-name>.<project>.shoot.gardener.<landscape>.apeirora.eu
