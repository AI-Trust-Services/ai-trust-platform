# Cluster init config for: ai-trust-main
# Used by shoot-cluster-init.sh — hostnames only, no credentials.
# DEFAULT_NAMESPACE: the canonical/long-running namespace for this cluster.
# Its hostnames come straight from the .env file (no subdomain derivation).
# Any other namespace gets subdomains derived from APP_HOST.
DEFAULT_NAMESPACE=main
APP_HOST=ai-trust-main.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu
KEYCLOAK_HOST=keycloak.ai-trust-main.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu
MINIO_HOST=minio.ai-trust-main.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu
