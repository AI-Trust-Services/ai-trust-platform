# Gardener shoot: ai-trust-main (project: ai-trust)
# Traefik LoadBalancer IP — change this one value to redeploy to a new IP.
LB_IP=130.214.18.172

# Gardener cluster connection — used by deploy-gardener.yml workflow
GARDENER_SHOOT_API_SERVER=https://api.ai-trust-main.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu
GARDENER_CA_DISCOVERY_URL=https://discovery.ingress.garden.gardener.cc-one.showroom.apeirora.eu/projects/ai-trust/shoots/beeaed7c-ce2d-4dd0-8af5-4bf46054b531/cluster-ca
GARDENER_OIDC_AUDIENCE=ai-trust-platform-ci
K8S_NAMESPACE=ai-trust

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# MinIO (Cold storage for ClickHouse tiering)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Frontend build — all derived from LB_IP
VITE_ALERTS_API_BASE=/api/alerts/v1
VITE_ALERTS_URL=https://ai-trust.${LB_IP}.nip.io/alerts
VITE_COMPLIANCE_API_BASE=/api/compliance/v1
VITE_COMPLIANCE_URL=https://ai-trust.${LB_IP}.nip.io/compliance
VITE_DTA_API_BASE=/api/dta/v1
VITE_MONITORING_API_BASE=/api/monitoring/v1
VITE_OVERVIEW_API_BASE=/api/overview/v1
VITE_REGISTRY_API_BASE=/api/registry/v1
VITE_REGISTRY_URL=https://ai-trust.${LB_IP}.nip.io/registry
VITE_USERS_API_BASE=/api/users/v1

# Compliance backend — MinIO evidence storage
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=minio.${LB_IP}.nip.io
MINIO_PUBLIC_URL=https://minio.${LB_IP}.nip.io
MINIO_SECURE=false
MINIO_REGION=us-east-1

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
USERS_BACKEND_CLIENT_SECRET=
KEYCLOAK_PUBLIC_URL=https://keycloak.${LB_IP}.nip.io
APP_PUBLIC_URL=https://ai-trust.${LB_IP}.nip.io

# Bootstrap platform admin user
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# oauth2-proxy cookie encryption secret — must be exactly 16, 24, or 32 characters
OAUTH2_PROXY_COOKIE_SECRET=

# CORS — backends fail to start if unset
ALLOWED_ORIGINS=https://ai-trust.${LB_IP}.nip.io

# AI System Registry — email notifications (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME="AI Trust Platform"
SMTP_SSL=false
SMTP_STARTTLS=false
USERS_BACKEND_URL=http://users-backend:8008

# AI System Registry — AI-assisted registration LLM
# LLM_PROVIDER: stub (default, offline/deterministic — no network), ollama, or external.
# Leave as stub for local dev/CI; the assisted flow works end-to-end without any LLM.
# NOTE: the stub ignores user input and walks a fixed demo script — for a real
# conversation that responds to answers, use ollama or external.
#
# To use ollama: set LLM_PROVIDER=ollama below and start the bundled ollama
# container via the compose profile (it is off by default):
#   docker compose --profile ollama up -d
# The models below are swappable — the ollama-pull job downloads exactly these,
# and the backend uses them. Change them here and re-run the command above.
LLM_PROVIDER=ollama
# ollama / OpenAI-compatible endpoint (used when LLM_PROVIDER=ollama)
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
LLM_VISION_MODEL=llama3.2-vision
# External provider — OAuth2 client-credentials + Anthropic-format /invoke (required only when LLM_PROVIDER=external)
AI_CLIENT_ID=
AI_CLIENT_SECRET=
AI_AUTH_URL=
AI_API_URL=
AI_RESOURCE_GROUP=default
AI_DEPLOYMENT_ID=
AI_API_VERSION=bedrock-2023-05-31
# Conversation / document tuning (optional — defaults shown)
ASSIST_TURN_CAP=12
ASSIST_MAX_TEXT_LENGTH=15000