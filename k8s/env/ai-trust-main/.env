# Gardener shoot: ai-trust-main (project: ai-trust)
# DNS via Gardener shoot-dns-service — A-records auto-published by shoot-cluster-init.sh (one-time manual setup).
# Shoot domain: ai-trust-main.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu

# Gardener cluster connection — used by deploy-gardener.yml workflow
GARDENER_SHOOT_API_SERVER=https://api.ai-trust-main.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu
GARDENER_CA_DISCOVERY_URL=https://discovery.ingress.garden.gardener.cc-one.showroom.apeirora.eu/projects/ai-trust/shoots/beeaed7c-ce2d-4dd0-8af5-4bf46054b531/cluster-ca
GARDENER_OIDC_AUDIENCE=ai-trust-platform-ci
K8S_NAMESPACE=ai-trust
SEED_DEV_USERS=true
DEV_USER_PASSWORD=

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# MinIO (Cold storage for ClickHouse tiering)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Frontend build — backend API base URLs baked into bundles by Vite at build time.
# All relative paths — traffic enters via the app public URL and is proxied by the shell nginx.
VITE_ALERTS_API_BASE=/api/alerts/v1
VITE_ALERTS_URL=https://ai-trust-main.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu/alerts
VITE_COMPLIANCE_API_BASE=/api/compliance/v1
VITE_COMPLIANCE_URL=https://ai-trust-main.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu/compliance
VITE_DTA_API_BASE=/api/dta/v1
VITE_MONITORING_API_BASE=/api/monitoring/v1
VITE_OVERVIEW_API_BASE=/api/overview/v1
VITE_REGISTRY_API_BASE=/api/registry/v1
VITE_REGISTRY_URL=https://ai-trust-main.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu/registry
VITE_USERS_API_BASE=/api/users/v1

# Compliance backend — MinIO evidence storage.
# MINIO_ENDPOINT: in-cluster address (unchanged from local).
# MINIO_PUBLIC_ENDPOINT: public host used by compliance-backend to presign
# download URLs the browser can reach. MinIO is exposed via its own Ingress entry.
# MINIO_PUBLIC_URL: full https URL — used by deploy-gardener.yml to create the MinIO Ingress.
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=minio.ai-trust-main.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu
MINIO_PUBLIC_URL=https://minio.ai-trust-main.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu
MINIO_SECURE=false
MINIO_REGION=us-east-1

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
KEYCLOAK_CLIENT_SECRET=
USERS_BACKEND_CLIENT_SECRET=
# Public URLs — must be reachable by the browser
KEYCLOAK_PUBLIC_URL=https://keycloak.ai-trust-main.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu
APP_PUBLIC_URL=https://ai-trust-main.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu

# Bootstrap platform admin user
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# oauth2-proxy cookie encryption secret — must be exactly 16, 24, or 32 characters
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
OAUTH2_PROXY_COOKIE_SECRET=

# CORS — backends fail to start if unset. Set to the app's public URL.
ALLOWED_ORIGINS=https://ai-trust-main.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu

# AI System Registry — email notifications (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME="AI Trust Platform"
SMTP_SSL=false
SMTP_STARTTLS=false
USERS_BACKEND_URL=http://users-backend:8008

# AI System Registry — AI-assisted registration (Thalamus inference backend)
# Thalamus runs in the thalamus namespace on this cluster.
# See k8s/thalamus/README.md for setup instructions.
THALAMUS_BASE_URL=http://inference-gateway.thalamus.svc.cluster.local/v1
THALAMUS_BEARER_TOKEN=
THALAMUS_MODEL=HuggingFaceTB/SmolLM2-135M-Instruct
THALAMUS_VISION_MODEL=HuggingFaceTB/SmolLM2-135M-Instruct
# Conversation / document tuning (optional — defaults shown)
ASSIST_TURN_CAP=12
ASSIST_MAX_TEXT_LENGTH=15000
