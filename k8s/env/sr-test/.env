# Gardener shoot: sr-test (project: ai-trust)
# DNS via Gardener shoot-dns-service — A-records auto-published by shoot-cluster-init.sh (one-time manual setup).
# Shoot domain: sr-test.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu

# Gardener cluster connection — used by deploy-gardener.yml workflow
GARDENER_SHOOT_API_SERVER=https://api.sr-test.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu
GARDENER_CA_DISCOVERY_URL=https://discovery.ingress.garden.gardener.cc-one.showroom.apeirora.eu/projects/ai-trust/shoots/6ffce6ae-34d2-4e76-8211-b3e3a7e093bb/cluster-ca
GARDENER_OIDC_AUDIENCE=ai-trust-platform-ci
K8S_NAMESPACE=ai-trust

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# MinIO (Cold storage for ClickHouse tiering)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Frontend build — backend API base URLs baked into bundles by Vite at build time.
# All relative paths — traffic enters via the app public URL and is proxied by the shell nginx.
VITE_ALERTS_API_BASE=/api/alerts/v1
VITE_ALERTS_URL=https://sr-test.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu/alerts
VITE_COMPLIANCE_API_BASE=/api/compliance/v1
VITE_COMPLIANCE_URL=https://sr-test.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu/compliance
VITE_DTA_API_BASE=/api/dta/v1
VITE_MONITORING_API_BASE=/api/monitoring/v1
VITE_OVERVIEW_API_BASE=/api/overview/v1
VITE_REGISTRY_API_BASE=/api/registry/v1
VITE_REGISTRY_URL=https://sr-test.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu/registry
VITE_USERS_API_BASE=/api/users/v1

# Compliance backend — MinIO evidence storage.
# MINIO_ENDPOINT: in-cluster address (unchanged from local).
# MINIO_PUBLIC_ENDPOINT: public host used by compliance-backend to presign
# download URLs the browser can reach. MinIO is exposed via its own Ingress entry.
# MINIO_PUBLIC_URL: full https URL — used by deploy-gardener.yml to create the MinIO Ingress.
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=minio.sr-test.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu
MINIO_PUBLIC_URL=https://minio.sr-test.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu
MINIO_SECURE=false
MINIO_REGION=us-east-1

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
KEYCLOAK_CLIENT_SECRET=
USERS_BACKEND_CLIENT_SECRET=
# Public URLs — must be reachable by the browser
KEYCLOAK_PUBLIC_URL=https://keycloak.sr-test.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu
APP_PUBLIC_URL=https://sr-test.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu

# Bootstrap platform admin user
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# oauth2-proxy cookie encryption secret — must be exactly 16, 24, or 32 characters
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
OAUTH2_PROXY_COOKIE_SECRET=

# CORS — backends fail to start if unset. Set to the app's public URL.
ALLOWED_ORIGINS=https://sr-test.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu

# AI System Registry — email notifications (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME="AI Trust Platform"
SMTP_SSL=false
SMTP_STARTTLS=false
USERS_BACKEND_URL=http://users-backend:8008

# AI System Registry — AI-assisted registration LLM
# LLM_PROVIDER: stub (default, offline/deterministic — no network), ollama, or external.
# Leave as stub for local dev/CI; the assisted flow works end-to-end without any LLM.
# NOTE: the stub ignores user input and walks a fixed demo script — for a real
# conversation that responds to answers, use ollama or external.
#
# To use ollama: set LLM_PROVIDER=ollama below and start the bundled ollama
# container via the compose profile (it is off by default):
#   docker compose --profile ollama up -d
# The models below are swappable — the ollama-pull job downloads exactly these,
# and the backend uses them. Change them here and re-run the command above.
LLM_PROVIDER=ollama
# ollama / OpenAI-compatible endpoint (used when LLM_PROVIDER=ollama)
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
LLM_VISION_MODEL=llama3.2-vision
# External provider — OAuth2 client-credentials + Anthropic-format /invoke (required only when LLM_PROVIDER=external)
AI_CLIENT_ID=
AI_CLIENT_SECRET=
AI_AUTH_URL=
AI_API_URL=
AI_RESOURCE_GROUP=default
AI_DEPLOYMENT_ID=
AI_API_VERSION=bedrock-2023-05-31
# Conversation / document tuning (optional — defaults shown)
ASSIST_TURN_CAP=12
ASSIST_MAX_TEXT_LENGTH=15000
