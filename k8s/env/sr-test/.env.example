# Gardener shoot: sr-test (project: ai-trust)
# Traefik LoadBalancer IP: 130.214.18.165
# DNS via nip.io (free wildcard DNS resolving to the LB IP, no setup needed).
#
# Copy this file to .env and fill in real secrets before deploying.
# The .env file is gitignored — never commit it.
# Upload the contents of your filled-in .env as the GitHub secret AI_TRUST_ENV_SR_TEST.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# MinIO (Cold storage for ClickHouse tiering)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# Frontend build — backend API base URLs baked into bundles by Vite at build time.
# All relative paths — traffic enters via the app public URL and is proxied by the shell nginx.
VITE_ALERTS_API_BASE=/api/alerts/v1
VITE_ALERTS_URL=https://ai-trust.130.214.18.165.nip.io/alerts
VITE_COMPLIANCE_API_BASE=/api/compliance/v1
VITE_COMPLIANCE_URL=https://ai-trust.130.214.18.165.nip.io/compliance
VITE_DTA_API_BASE=/api/dta/v1
VITE_MONITORING_API_BASE=/api/monitoring/v1
VITE_OVERVIEW_API_BASE=/api/overview/v1
VITE_REGISTRY_API_BASE=/api/registry/v1
VITE_REGISTRY_URL=https://ai-trust.130.214.18.165.nip.io/registry
VITE_USERS_API_BASE=/api/users/v1

# Compliance backend — MinIO evidence storage.
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=minio.130.214.18.165.nip.io
MINIO_PUBLIC_URL=https://minio.130.214.18.165.nip.io
MINIO_SECURE=false
MINIO_REGION=us-east-1

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
KEYCLOAK_CLIENT_SECRET=change-me
USERS_BACKEND_CLIENT_SECRET=change-me
# Public URLs — must be reachable by the browser
KEYCLOAK_PUBLIC_URL=https://keycloak.130.214.18.165.nip.io
APP_PUBLIC_URL=https://ai-trust.130.214.18.165.nip.io

# Bootstrap platform admin user
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me

# oauth2-proxy cookie encryption secret — must be exactly 16, 24, or 32 characters
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
OAUTH2_PROXY_COOKIE_SECRET=change-me-32-char-secret-here!!!

# CORS — backends fail to start if unset. Set to the app's public URL.
ALLOWED_ORIGINS=https://ai-trust.130.214.18.165.nip.io
