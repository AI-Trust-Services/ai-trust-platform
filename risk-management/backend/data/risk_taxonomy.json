  "risks": [
    {
      "id": "TAX-001",
      "title": "Algorithmic bias and discrimination",
      "category": "bias",
      "description": "The AI system may produce outputs that systematically disadvantage individuals or groups based on protected characteristics such as race, gender, age, disability, or socioeconomic status, either directly or via proxy variables.",
      "applicable_annex_iii_categories": ["employment", "essential_services", "education", "law_enforcement", "justice"],
      "default_severity": "high",
      "taxonomy_mappings": [
        {"taxonomy": "AI_Act", "category": "Fundamental rights risk", "identifier": "Art. 10(2)(f)"},
        {"taxonomy": "NIST_AI_RMF", "category": "BIAS", "identifier": "GOVERN 6.1"},
        {"taxonomy": "MIT_AIRR", "category": "Discrimination / toxicity", "identifier": "2.5"},
        {"taxonomy": "OWASP_LLM", "category": "Training Data Poisoning", "identifier": "LLM03:2025"}
      ],
      "keywords": ["bias", "discrimination", "fairness", "disparate impact", "protected attribute", "demographic", "race", "gender", "ethnicity", "age"],
      "affects_vulnerable_groups": true,
      "common_vulnerable_groups": ["ethnic minorities", "women", "people with disabilities", "elderly", "low-income individuals"]
    },
    {
      "id": "TAX-002",
      "title": "Proxy discrimination via correlated variables",
      "category": "bias",
      "description": "Even when protected attributes are excluded as direct inputs, the system may learn discriminatory patterns from variables that are statistically correlated with protected characteristics (e.g. postal code as a proxy for ethnicity).",
      "applicable_annex_iii_categories": ["employment", "essential_services", "education", "law_enforcement"],
      "default_severity": "high",
      "taxonomy_mappings": [
        {"taxonomy": "AI_Act", "category": "Fundamental rights risk", "identifier": "Art. 10(2)(f)"},
