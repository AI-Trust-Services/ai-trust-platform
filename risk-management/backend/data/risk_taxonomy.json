      "keywords": ["proxy", "correlation", "postal code", "zip code", "neighbourhood", "indirect discrimination", "redlining"],
      "affects_vulnerable_groups": true,
      "common_vulnerable_groups": ["ethnic minorities", "low-income individuals", "residents of deprived areas"]
    },
